# ─────────────────────────────────────────────────────────────
# AERIQ Backend — environment variables
# Copy this file to backend/.env and fill in the values.
# Never commit .env. Every key here is server-only.
# ─────────────────────────────────────────────────────────────


# ── Server & Mock mode ───────────────────────────────────────
# Standalone backend HTTP port
PORT=4000

# true  = every /api/v1 route returns fixtures from src/mocks/
#         (no database, provider or Gemini keys needed)
# false = real database, providers and Gemini
USE_MOCKS=true


# ── Database (PostgreSQL 16 + PostGIS) ───────────────────────
# Neon: console.neon.tech → New project → Connection string
# Supabase: Project settings → Database → Connection string (URI)
# Run "CREATE EXTENSION IF NOT EXISTS postgis;" once before migrating.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/aeriq?sslmode=require


# ── Auth / Session signing ───────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Base URL of the app (no trailing slash)
AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
# Optional test database connection string for integration tests
TEST_DATABASE_URL=
# Set to true when deployed behind Vercel or another proxy
AUTH_TRUST_HOST=true


# ── CPCB data (data.gov.in) ──────────────────────────────────
# data.gov.in → sign up → My Account → API key
DATA_GOV_API_KEY=
# Resource ID of the CPCB real-time air quality dataset on data.gov.in
# (copy it from the dataset's API page)
CPCB_RESOURCE_ID=


# ── OpenAQ v3 ────────────────────────────────────────────────
# explore.openaq.org → sign up → API key (sent as X-API-Key)
OPENAQ_API_KEY=


# ── Open-Meteo ───────────────────────────────────────────────
# Air Quality and Forecast APIs need no key for non-commercial use.
# Only fill this if you buy a commercial plan.
OPEN_METEO_API_KEY=


# ── Google Gemini ────────────────────────────────────────────
# aistudio.google.com → Get API key
GEMINI_API_KEY=
# Pick a current Gemini model that supports JSON schema output
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TIMEOUT_MS=20000
GEMINI_DAILY_CAP=200


# ── Upstash Redis (cache + rate limits) ──────────────────────
# console.upstash.com → Create database → REST API section
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ── Cron jobs ────────────────────────────────────────────────
# Sent as "Authorization: Bearer <CRON_SECRET>" to /api/cron/*
# Generate with: openssl rand -hex 32
CRON_SECRET=


# ── Data rules (defaults match the build prompt) ─────────────
# Freshness: fresh up to 90 min, aging up to 3 h, stale after
FRESH_MAX_MIN=90
AGING_MAX_MIN=180
# CPCB AQI: minimum hourly values for a 24 h and an 8 h sub-index
AQI_MIN_HOURS_24H=16
AQI_MIN_HOURS_8H=6
# Stations within this radius of a saved location are ingested
INGEST_RADIUS_KM=25
# Community report rounding (~500 m)
COMMUNITY_ROUND_DEG=0.005
# Purifier guidance defaults
PURIFIER_CEILING_HEIGHT_M=2.7
PURIFIER_TARGET_AIR_CHANGES=5
# Timezone used for display and cron schedules
APP_TIMEZONE=Asia/Kolkata


# ── Admin ────────────────────────────────────────────────────
# Comma-separated emails that get the admin role (community moderation)
ADMIN_EMAILS=

# ── Observability & Email (optional) ─────────────────────────
SENTRY_DSN=
RESEND_API_KEY=
