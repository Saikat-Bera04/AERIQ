# ─────────────────────────────────────────────────────────────
# AERIQ Frontend — environment variables
# Copy this file to frontend/.env.local and fill in the values.
# Never commit .env.local. Client-exposed keys must start with
# NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────


# ── Backend API & Mock mode ──────────────────────────────────
# Base URL of the standalone AERIQ backend server (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:4000

# true  = use validated mock fixtures (no backend/database required)
# false = call live backend API at NEXT_PUBLIC_API_URL
NEXT_PUBLIC_USE_MOCKS=true


# ── Auth.js v5 (Frontend session) ────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Base URL of the frontend app (no trailing slash)
AUTH_URL=http://localhost:3000
